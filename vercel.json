{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/kiosk",
      "destination": "/kiosk.html"
    },
    {
      "source": "/dashboard",
      "destination": "/kiosk.html"
    },
    {
      "source": "/teacher/settings/kiosk",
      "destination": "/api/teacher/kiosk"
    },
    {
      "source": "/pe",
      "destination": "/pe.html"
    },
    {
      "source": "/teacher/settings/pe",
      "destination": "/api/teacher/pe"
    },
    {
      "source": "/auth/callback",
      "destination": "/api/auth/callback"
    },
    {
      "source": "/auth/access-pending",
      "destination": "/auth/access-pending.html"
    },
    {
      "source": "/zones",
      "destination": "/zones/index.html"
    },
    {
      "source": "/teacher/students",
      "destination": "/api/teacher/students"
    },
    {
      "source": "/teacher/students/:studentId",
      "destination": "/api/teacher/students/:studentId"
    },
    {
      "source": "/teacher/kami",
      "destination": "/api/teacher/kami"
    },
    {
      "source": "/teacher/messages",
      "destination": "/api/teacher/messages"
    },
    {
      "source": "/teacher",
      "destination": "/api/teacher/learning"
    },
    {
      "source": "/teacher/zones",
      "destination": "/api/teacher/learning"
    },
    {
      "source": "/teacher/assignments",
      "destination": "/api/teacher/learning"
    },
    {
      "source": "/teacher/settings",
      "destination": "/api/teacher/learning"
    },
    {
      "source": "/teacher/settings/goals",
      "destination": "/api/teacher/learning"
    },
    {
      "source": "/teacher/progress",
      "destination": "/api/teacher/learning"
    },
    {
      "source": "/teacher/history",
      "destination": "/api/teacher/history"
    },
    {
      "source": "/student/zones/:zone",
      "destination": "/zones/index.html"
    },
    {
      "source": "/student/journal",
      "destination": "/journal.html"
    },
    {
      "source": "/student/journal/:path*",
      "destination": "/journal.html"
    }
  ],
  "headers": [
    {
      "source": "/pe",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/pe.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/kiosk",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/kiosk.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
